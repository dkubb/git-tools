/// Exit code for bad input / not found
const EXIT_DATAERR: i32 = 65;

/// Exit code for unexpected internal failure
const EXIT_SOFTWARE: i32 = 70;

/// Validation errors for git references
#[derive(Debug, Error)]
enum ValidationError {
    /// Reference cannot be empty
    #[error("Git reference cannot be empty")]
    RefEmpty,

    /// Reference was not found in the repository
    #[error("Git reference not found: {ref_name}\nDETAILS: {details}")]
    RefNotFound {
        /// The name of the reference that was not found
        ref_name: String,

        /// Underlying git error message (if any)
        details: String,
    },

    /// Failed to execute git rev-parse command
    #[error("Failed to execute git rev-parse: {details}")]
    RevParseFailed {
        /// Underlying OS error (if any)
        details: String,
    },
}

/// A validated git reference containing its commit SHA
#[derive(Debug, Clone)]
struct GitRef(String);

impl FromStr for GitRef {
    type Err = ValidationError;

    /// Creates a `GitRef` from a string reference name
    fn from_str(input: &str) -> Result<Self, Self::Err> {
        if input.is_empty() {
            return Err(ValidationError::RefEmpty);
        }

        // Validate that the ref exists using git rev-parse
        let sha = validate_git_ref(input)?;
        Ok(Self(sha))
    }
}

impl GitRef {
    /// Returns the SHA string of this git reference
    fn as_str(&self) -> &str {
        &self.0
    }
}

/// Command line arguments for git-fix-branch
#[derive(Parser, Debug)]
#[command(name = "git-fix-branch")]
#[command(about = "Fix branch commit data to be the same as author data and ensure monotonic dates", long_about = None)]
struct Args {
    /// Show what would be done without making changes
    #[arg(long)]
    dry_run: bool,

    /// Rewrite the entire branch back to the repository root
    #[arg(long)]
    root: bool,

    /// Branches to stack (each rebased on the previous)
    ///
    /// With 0 args: auto-detect parent, fix current branch
    /// With 1 arg: use as parent, fix current branch
    /// With 2+ args: stack mode, rebase each branch on the previous
    branches: Vec<String>,
}

/// Range of commits to be processed
#[derive(Clone)]
enum CommitRange {
    /// Commits from a parent reference to HEAD (inclusive)
    ParentRange(String),

    /// All commits from the repository root to HEAD
    RootRange,
}

/// Validates that a git reference exists and returns its commit SHA
fn validate_git_ref(ref_name: &str) -> Result<String, ValidationError> {
    let output = Command::new("git")
        .args(["rev-parse", "--verify", &format!("{ref_name}^{{commit}}")])
        .output()
        .map_err(|e| ValidationError::RevParseFailed {
            details: e.to_string(),
        })?;

    if !output.status.success() {
        let details = String::from_utf8_lossy(&output.stderr).trim().to_owned();
        let details = if details.is_empty() {
            String::from("git rev-parse failed")
        } else {
            details
        };
        return Err(ValidationError::RefNotFound {
            ref_name: ref_name.to_owned(),
            details,
        });
    }

    Ok(String::from_utf8_lossy(&output.stdout).trim().to_owned())
}

/// Main entry point for git-fix-branch
fn main() {
    let Args {
        branches,
        dry_run,
        root,
    } = Args::parse();

    // Check we're in a git repository
    if Command::new("git")
        .args(["rev-parse", "--git-dir"])
        .stdout(Stdio::null())
        .stderr(Stdio::null())
        .status()
        .map_or(true, |status| !status.success())
    {
        eprintln!("✗ ERROR: Not a git repository (or any of the parent directories).");
        eprintln!("NEXT: cd into a repo, or run: git init");
        exit(EXIT_DATAERR);
    }

    // Determine the execution mode based on arguments
    match branches.len() {
        0 => {
            // No branches: auto-detect parent, fix current branch
            if root {
                run_fix_branch(None, true, dry_run);
            } else {
                let parent = resolve_parent_or_exit();
                run_fix_branch(Some(&parent), false, dry_run);
            }
        }
        1 => {
            // Single branch: use as parent, fix current branch
            if root {
                eprintln!("✗ ERROR: --root cannot be used with a single branch argument.");
                eprintln!("NEXT: Either omit --root to use the branch as parent, or omit the branch to fix current branch from root.");
                exit(EXIT_DATAERR);
            }
            let parent = validate_branch_or_exit(&branches[0]);
            run_fix_branch(Some(&parent), false, dry_run);
        }
        _ => {
            // Multiple branches: stack mode
            run_stack_mode(&branches, root, dry_run);
        }
    }
}

/// Resolves the default parent branch or exits with an error
fn resolve_parent_or_exit() -> GitRef {
    match resolve_default_branch() {
        Ok(default_branch) => match GitRef::from_str(&default_branch) {
            Ok(git_ref) => git_ref,
            Err(error) => {
                eprintln!("✗ ERROR: {error}");
                eprintln!("NEXT: Provide a parent branch or fix the default branch configuration");
                exit(EXIT_DATAERR);
            }
        },
        Err(message) => {
            eprintln!("✗ ERROR: {message}");
            eprintln!("NEXT: Provide a parent branch or configure init.defaultBranch");
            exit(EXIT_DATAERR);
        }
    }
}

/// Validates a branch name and returns a GitRef or exits with an error
fn validate_branch_or_exit(branch: &str) -> GitRef {
    match GitRef::from_str(branch) {
        Ok(git_ref) => git_ref,
        Err(error) => {
            eprintln!("✗ ERROR: {error}");
            exit(EXIT_DATAERR);
        }
    }
}

/// Gets the current branch name or exits with an error
fn get_current_branch_or_exit() -> String {
    match git_output_optional(&["symbolic-ref", "--short", "HEAD"]) {
        Some(branch) => branch,
        None => {
            // Might be in detached HEAD state, get the commit SHA
            match git_output_optional(&["rev-parse", "--short", "HEAD"]) {
                Some(sha) => sha,
                None => {
                    eprintln!("✗ ERROR: Unable to determine current branch or HEAD.");
                    exit(EXIT_SOFTWARE);
                }
            }
        }
    }
}

/// Checks out a branch or exits with an error
fn checkout_branch(branch: &str) {
    println!("→ Checking out {branch}");
    let status = Command::new("git")
        .args(["checkout", branch])
        .status();

    match status {
        Ok(s) if s.success() => {}
        Ok(_) => {
            eprintln!("✗ ERROR: Failed to checkout branch: {branch}");
            exit(EXIT_SOFTWARE);
        }
        Err(error) => {
            eprintln!("✗ ERROR: Failed to execute git checkout");
            eprintln!("DETAILS: {error}");
            exit(EXIT_SOFTWARE);
        }
    }
}

/// Runs stack mode: rebase each branch on the previous one
fn run_stack_mode(branches: &[String], root: bool, dry_run: bool) {
    // Validate all branches exist upfront (for early error detection)
    for branch in branches {
        validate_branch_or_exit(branch);
    }

    // Save the original branch to return to later
    let original_branch = get_current_branch_or_exit();

    if dry_run {
        println!("→ [DRY RUN] Would save current branch: {original_branch}");
    }

    // Determine the starting index based on --root flag
    let start_index = if root {
        // With --root, first branch is fixed from root
        if dry_run {
            println!("→ [DRY RUN] Would checkout {}", branches[0]);
            println!("→ [DRY RUN] Would fix {} from repository root", branches[0]);
        } else {
            checkout_branch(&branches[0]);
            run_fix_branch_by_name(None, true, dry_run);
        }
        1
    } else {
        // Without --root, first branch is just a parent for the second
        1
    };

    // Process remaining branches
    // Use branch names (not SHAs) so we get the current tip after each rewrite
    for i in start_index..branches.len() {
        let parent = &branches[i - 1];
        let child = &branches[i];

        if dry_run {
            println!("→ [DRY RUN] Would checkout {child}");
            println!("→ [DRY RUN] Would rebase {child} on {parent}");
        } else {
            checkout_branch(child);
            run_fix_branch_by_name(Some(parent), false, dry_run);
        }
    }

    // Return to the original branch
    if dry_run {
        println!("→ [DRY RUN] Would return to original branch: {original_branch}");
        println!("✓ [DRY RUN] Stack would be fixed successfully");
    } else {
        checkout_branch(&original_branch);
        println!("✓ Stack fixed successfully");
    }
}

/// Runs the fix-branch operation on the current branch using a branch name
fn run_fix_branch_by_name(parent: Option<&str>, root: bool, dry_run: bool) {
    if dry_run {
        if let Some(parent_name) = parent {
            println!("→ [DRY RUN] Would rebase on {parent_name}");
        } else {
            println!("→ [DRY RUN] Would skip rebase (root mode)");
        }
        if root {
            println!("→ [DRY RUN] Would fix committer data and normalize dates from the repository root");
        } else {
            println!("→ [DRY RUN] Would fix committer data and normalize dates");
        }
        println!("✓ [DRY RUN] Branch would be fixed successfully");
        return;
    }

    // Rebase the current branch on top of the parent
    if let Some(parent_name) = parent {
        println!("→ Rebasing on {parent_name}");
        git_run(&[
            "rebase",
            "--rebase-merges",
            "--no-keep-empty",
            "--update-refs",
            "--",
            parent_name,
        ]);

        // Autosquash any fixup!/squash!/amend! commits
        if has_autosquash_commits(parent_name) {
            println!("→ Autosquashing fixup/squash/amend commits");
            git_run_with_env(
                &[
                    "rebase",
                    "--interactive",
                    "--autosquash",
                    "--no-keep-empty",
                    "--update-refs",
                    "--",
                    parent_name,
                ],
                &[("GIT_SEQUENCE_EDITOR", ":")],
            );
        }
    } else {
        println!("→ Skipping rebase (root mode)");
    }

    // Prepare the commit range we're going to inspect or rewrite
    let parent_range = parent.map(|name| format!("{name}..HEAD"));
    let commit_range = match (&parent_range, root) {
        (Some(range), false) => CommitRange::ParentRange(range.to_owned()),
        (None, true) => CommitRange::RootRange,
        _ => {
            eprintln!("✗ ERROR: Unexpected state while determining commit range.");
            exit(EXIT_SOFTWARE);
        }
    };

    // Short-circuit when everything already matches
    match branch_needs_fix(&commit_range) {
        Ok(false) => {
            println!("→ Commits already have matching committer data and monotonic dates");
            println!("✓ No rewrite needed");
            return;
        }
        Ok(true) => { /* continue */ }
        Err(message) => {
            eprintln!("✗ ERROR: {message}");
            exit(EXIT_SOFTWARE);
        }
    }

    // Rewrite all commits to use the author data and normalize dates
    if root {
        println!("→ Fixing committer data and normalizing dates from the repository root");
    } else {
        println!("→ Fixing committer data and normalizing dates");
    }

    // Create temp file path for tracking max date across commits
    let max_date_file = std::env::temp_dir().join(format!(
        "git-fix-branch-max-date-{}",
        std::process::id()
    ));

    // Clean up any stale temp file from previous runs
    let _ = std::fs::remove_file(&max_date_file);

    let env_filter = format!(
        r#"
MAX_DATE_FILE="{max_date_file}"

# Read current max date (or 0 if first commit)
if [ -f "$MAX_DATE_FILE" ]; then
    max_date=$(cat "$MAX_DATE_FILE")
else
    max_date=0
fi

# Get author date as unix timestamp using git
author_unix=$(git log -1 --format='%ad' --date=unix "$GIT_COMMIT" 2>/dev/null || echo "0")

# Also get max parent date for this commit
parent_max=0
for parent in $(git rev-parse "$GIT_COMMIT^@" 2>/dev/null); do
    parent_date=$(git log -1 --format='%ad' --date=unix "$parent" 2>/dev/null || echo "0")
    if [ "$parent_date" -gt "$parent_max" ] 2>/dev/null; then
        parent_max=$parent_date
    fi
done

# Use the greater of running max or parent max
if [ "$parent_max" -gt "$max_date" ] 2>/dev/null; then
    max_date=$parent_max
fi

# Determine final date
if [ "$author_unix" -le "$max_date" ] 2>/dev/null; then
    final_date=$((max_date + 1))
else
    final_date=$author_unix
fi

# Update max date file
echo "$final_date" > "$MAX_DATE_FILE"

# Export the normalized values
export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME"
export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"
export GIT_AUTHOR_DATE="@$final_date"
export GIT_COMMITTER_DATE="@$final_date"
"#,
        max_date_file = max_date_file.display()
    );

    let mut command = Command::new("git");
    command.args(["filter-branch", "--force", "--env-filter", &env_filter, "--"]);

    match (&commit_range, root) {
        (CommitRange::ParentRange(range), false) => {
            command.arg(range);
        }
        (CommitRange::RootRange, true) => {
            command.args(["--root", "HEAD"]);
        }
        _ => {
            eprintln!("✗ ERROR: Unexpected state while preparing git filter-branch.");
            exit(EXIT_SOFTWARE);
        }
    }

    let result = command
        .env("FILTER_BRANCH_SQUELCH_WARNING", "1")
        .stdout(Stdio::piped())
        .stderr(Stdio::piped())
        .output();

    // Clean up temp file
    let _ = std::fs::remove_file(&max_date_file);

    match result {
        Ok(output) if output.status.success() => {
            emit_filter_branch_output(&output.stdout, &output.stderr);

            match git_head_sha() {
                Ok(after_head) => {
                    println!("Rewrite {after_head}");
                }
                Err(message) => {
                    eprintln!("✗ ERROR: {message}");
                    exit(EXIT_SOFTWARE);
                }
            }

            println!("✓ Branch fixed successfully");
        }
        Ok(output) => {
            emit_filter_branch_output(&output.stdout, &output.stderr);
            eprintln!("✗ ERROR: git filter-branch failed");
            exit(EXIT_SOFTWARE);
        }
        Err(error) => {
            eprintln!("✗ ERROR: Failed to execute git filter-branch");
            eprintln!("DETAILS: {error}");
            exit(EXIT_SOFTWARE);
        }
    }
}

