#!/usr/bin/env rust-script
//! ```cargo
//! [package]
//! edition = "2024"
//!
//! [dependencies]
//! clap = { version = "4.5.50", features = ["derive"] }
//! thiserror = "2.0.17"
//!
//! [dev-dependencies]
//! proptest = "1.6"
//! tempfile = "3.23"
//! wait-timeout = "0.2"
//! ```
//!
//! Fetch a PR base, rebase a local branch, and publish with lease protection.

#![forbid(unsafe_code)]
#![deny(warnings)]
#![deny(clippy::all, clippy::pedantic, clippy::nursery, clippy::cargo)]
#![expect(
    clippy::blanket_clippy_restriction_lints,
    reason = "Enable restriction lints with explicit exceptions for this CLI"
)]
#![deny(clippy::restriction)]
#![expect(
    clippy::implicit_return,
    reason = "Tail expressions are idiomatic Rust"
)]
#![expect(
    clippy::question_mark_used,
    reason = "Propagate typed failures to the CLI boundary"
)]
#![expect(
    clippy::single_call_fn,
    reason = "Named workflow steps keep the command readable"
)]
#![expect(
    clippy::cargo_common_metadata,
    reason = "rust-script generates an unpublished package"
)]

extern crate alloc;

/// Domain values are constructed only through this module's parsers.
#[expect(
    clippy::pub_with_shorthand,
    reason = "Use idiomatic restricted visibility"
)]
#[expect(
    clippy::redundant_pub_crate,
    reason = "Keep constructors restricted if module visibility changes"
)]
mod domain {
    use super::{Error, config, query, record};

    /// Git owns the grammar; a private constructor preserves its evidence.
    /// The 1024-byte operational cap is estimated, not a Git protocol limit.
    #[derive(Debug, Eq, PartialEq)]
    pub(super) struct BranchName(String);

    impl BranchName {
        /// Borrow the original spelling at the subprocess boundary.
        pub(super) fn as_str(&self) -> &str {
            &self.0
        }
        /// Preserve the name exactly after checking bounds and Git's grammar.
        pub(super) fn try_new(value: &str) -> Result<Self, Error> {
            if value.is_empty() || value.len() > 1024 || value.starts_with('-') {
                return Err(Error::InvalidBranch);
            }
            query("git", &["check-ref-format", &format!("refs/heads/{value}")])?;
            Ok(Self(value.to_owned()))
        }
    }

    /// A full SHA-1 or SHA-256 object ID, never a mutable ref or revision expression.
    pub(super) struct CommitId(String);

    impl CommitId {
        /// Borrow the canonical ID for Git arguments.
        pub(super) fn as_str(&self) -> &str {
            &self.0
        }
        /// Parse Git's full lowercase hexadecimal object ID representation.
        pub(super) fn try_new(value: &str) -> Result<Self, Error> {
            if !matches!(value.len(), 40 | 64)
                || !value
                    .bytes()
                    .all(|byte| byte.is_ascii_digit() || matches!(byte, b'a'..=b'f'))
            {
                return Err(Error::InvalidCommit);
            }
            Ok(Self(value.to_owned()))
        }
    }

    /// Exactly one source and one distinct base, without duplicated ref strings.
    pub(super) struct RebaseTarget {
        /// Immediate parent branch.
        base: BranchName,
        /// Branch being published.
        branch: BranchName,
        /// Explicit remote destination; absence means the source name.
        destination: Option<BranchName>,
    }

    impl RebaseTarget {
        /// Borrow the parent identity.
        pub(super) const fn base(&self) -> &BranchName {
            &self.base
        }

        /// Borrow the publication identity.
        pub(super) const fn branch(&self) -> &BranchName {
            &self.branch
        }
        /// Borrow the remote branch identity.
        pub(super) fn destination(&self) -> &BranchName {
            self.destination.as_ref().unwrap_or(&self.branch)
        }
        /// Admit only source and destination identities distinct from the base.
        pub(super) fn new(
            branch: BranchName,
            destination: Option<BranchName>,
            base: BranchName,
        ) -> Result<Self, Error> {
            if branch == base || destination.as_ref() == Some(&base) {
                return Err(Error::SameBranch);
            }
            Ok(Self {
                base,
                branch,
                destination,
            })
        }
    }
    /// One named remote with one shared fetch/push endpoint.
    /// Separate or multiple push URLs cannot share this command's atomic fetch.
    pub(super) struct Remote {
        /// Validated name in Git's remote-tracking namespace.
        name: BranchName,
        /// Endpoint used to scope GitHub PR lookup.
        url: String,
    }

    impl Remote {
        /// Borrow the configured remote name.
        pub(super) fn name(&self) -> &str {
            self.name.as_str()
        }

        /// Reject configurations that cannot be covered by one fetched lease.
        pub(super) fn try_new(value: &str) -> Result<Self, Error> {
            let name = BranchName::try_new(value)?;
            let mirror = query(
                "git",
                &[
                    "config",
                    "--type=bool",
                    "--default=false",
                    "--get",
                    &format!("remote.{value}.mirror"),
                ],
            )?;
            if record(&mirror)? == "true" {
                return Err(Error::PushConfiguration("mirror remotes are unsupported"));
            }
            let fetch = query("git", &["remote", "get-url", "--all", value])?;
            let push = query("git", &["remote", "get-url", "--push", "--all", value])?;
            let url = record(&fetch)?;
            if url.is_empty() || record(&push)? != url {
                return Err(Error::PushConfiguration(
                    "one identical fetch/push URL is required",
                ));
            }
            // Validate cardinality even when a CLI refspec overrides the mapping.
            if let Some(spec) = config(&format!("remote.{value}.push"))?
                && (spec.contains('*') || spec.starts_with(':') || spec.starts_with('+'))
            {
                return Err(Error::PushConfiguration(
                    "push defaults must name one branch without force, wildcards, or deletion",
                ));
            }
            Ok(Self {
                name,
                url: url.to_owned(),
            })
        }

        /// Borrow the repository endpoint for PR discovery.
        pub(super) fn url(&self) -> &str {
            &self.url
        }
    }
}

/// Real Git subprocess integration tests.
#[cfg(test)]
#[path = "tests/git-push-up.rs"]
mod integration;

/// Boundary examples and generated preservation properties.
#[cfg(test)]
mod tests {

    /// Generated names retain every byte after parsing and framing.
    #[expect(
        clippy::unwrap_used,
        reason = "Proptest assertions require successful valid fixtures"
    )]
    mod properties {
        use super::{BranchName, CommitId, RebaseTarget, fetched_commit, parse_selection, record};
        use proptest::prelude::{any, prop_assert, prop_assert_eq, proptest};
        use std::process::Command;

        proptest! {
            #[test]
            fn branch_roundtrip(value in any::<String>()) {
                let expected = Command::new("git")
                    .args(["check-ref-format", &format!("refs/heads/{value}")])
                    .output().is_ok_and(|output| output.status.success())
                    && !value.starts_with('-') && !value.is_empty() && value.len() <= 1024;
                let parsed = BranchName::try_new(&value);
                prop_assert_eq!(parsed.is_ok(), expected);
                if let Ok(name) = parsed {
                    prop_assert_eq!(name.as_str(), value.as_str());
                }
            }

            #[test]
            fn target_requires_distinct_branches(left in "[a-z]{1,32}", right in "[a-z]{1,32}") {
                let source = BranchName::try_new(&left).unwrap();
                let base = BranchName::try_new(&right).unwrap();
                let target = RebaseTarget::new(source, None, base);
                prop_assert_eq!(target.is_ok(), left != right);
                if let Ok(value) = target {
                    prop_assert_eq!(value.branch().as_str(), left);
                    prop_assert_eq!(value.base().as_str(), right);
                }
            }

            #[test]
            fn refspec_roundtrip(source in "[a-z]{1,32}", destination in "[a-z]{1,32}") {
                let input = format!("{source}:{destination}");
                let (branch, remote) = parse_selection(&input).unwrap();
                prop_assert_eq!(branch.as_str(), source);
                let remote_branch = remote.unwrap();
                prop_assert_eq!(remote_branch.as_str(), destination.as_str());
                let deletion = format!(":{destination}");
                prop_assert!(parse_selection(&deletion).is_err());
            }

            #[test]
            fn fetched_commit_preserves_snapshot(commit in "[0-9a-f]{40}|[0-9a-f]{64}", branch in "[a-z]{1,32}") {
                let reference = format!("refs/remotes/origin/{branch}\u{a0}");
                let output = format!("= {commit} {commit} {reference}\n");
                let parsed = fetched_commit(&output, &reference).unwrap();
                prop_assert_eq!(parsed.as_str(), commit);
                prop_assert!(fetched_commit(&output, "refs/remotes/other/branch").is_err());
                let duplicate = format!("{output}{output}");
                prop_assert!(fetched_commit(&duplicate, &reference).is_err());
            }

            #[test]
            fn target_rejects_destination_base_collision(source in "[a-z]{1,32}", destination in "[a-z]{1,32}", base in "[a-z]{1,32}") {
                let target = RebaseTarget::new(BranchName::try_new(&source).unwrap(), Some(BranchName::try_new(&destination).unwrap()), BranchName::try_new(&base).unwrap());
                prop_assert_eq!(target.is_ok(), source != base && destination != base);
            }

            #[test]
            fn commit_roundtrip(value in "[0-9a-f]{40}|[0-9a-f]{64}") {
                let parsed = CommitId::try_new(&value).unwrap();
                prop_assert_eq!(parsed.as_str(), value);
            }

            #[test]
            fn commit_rejects_invalid(value in "[g-z]{40}|[0-9a-f]{0,39}|[0-9a-f]{41,63}|[0-9a-f]{65,80}") {
                prop_assert!(CommitId::try_new(&value).is_err());
            }

            #[test]
            fn record_preserves_unicode(value in any::<String>()) {
                let framed = format!("{value}\n");
                let parsed = record(&framed);
                if value.contains('\n') || value.contains('\r') {
                    prop_assert!(parsed.is_err());
                } else {
                    prop_assert_eq!(parsed.unwrap(), value);
                }
            }
        }
    }

    use super::{
        BranchName, CommitId, Error, RebaseTarget, fetched_commit, parse_selection, record,
    };

    /// Pin grammar, framing, ID lengths, and target inequality at their boundaries.
    #[test]
    #[expect(
        clippy::unwrap_used,
        reason = "A rejected valid fixture must fail the test"
    )]
    fn boundaries() {
        for value in ["", "-x", "a..b", "a b", "a\n", "a.lock"] {
            BranchName::try_new(value).unwrap_err();
        }
        for value in ["a", "feature\u{a0}"] {
            assert_eq!(BranchName::try_new(value).unwrap().as_str(), value);
        }
        let maximum = format!("{}a", "a/".repeat(511));
        BranchName::try_new(&maximum).unwrap();
        BranchName::try_new(&format!("{maximum}a")).unwrap();
        BranchName::try_new(&format!("{maximum}aa")).unwrap_err();
        for length in [0, 39, 41, 63, 65] {
            assert!(CommitId::try_new(&"a".repeat(length)).is_err());
        }
        for length in [40, 64] {
            CommitId::try_new(&"a".repeat(length)).unwrap();
        }
        record("main").unwrap_err();
        record("main\nother\n").unwrap_err();
        assert_eq!(record("feature\u{a0}\n").unwrap(), "feature\u{a0}");
        assert!(matches!(
            RebaseTarget::new(
                BranchName::try_new("main").unwrap(),
                None,
                BranchName::try_new("main").unwrap()
            ),
            Err(Error::SameBranch)
        ));
    }
}

