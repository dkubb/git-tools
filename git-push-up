/// Rebase onto the latest fetched PR base, then push the selected branch.
///
/// Select a repository with `git -C <path> push-up`. Both branches must
/// already exist on the resolved push remote. Git push defaults select one branch
/// when no source is supplied; the push remote follows the checked-out branch, as in git push.
/// Mirror, wildcard, multiple-ref and separate-push-URL configurations are rejected.
/// The selected local branch must include its remote
/// tip before rewriting unless --replace is supplied. A successful rebase leaves
/// that branch checked out and rewritten even if the subsequent push fails.
/// Default mode can move other local branches through --update-refs. Replacement
/// mode disables that behavior. Only the selected destination is pushed.
/// Requires Git with fetch --porcelain support.
#[derive(Debug, Parser)]
#[command(name = "git-push-up")]
struct Args {
    /// Immediate base branch (defaults to the destination branch's GitHub PR base).
    #[arg(long)]
    base: Option<String>,
    /// Local source, optionally SOURCE:DESTINATION; HEAD means the current branch.
    #[arg(value_name = "SOURCE[:DESTINATION]")]
    branch: Option<String>,
    /// Print the plan without fetching, rebasing, or pushing.
    #[arg(long)]
    dry_run: bool,
    /// Replace non-ancestral destination history using a lease pinned at fetch.
    /// Does not move other local branches through --update-refs.
    #[arg(long)]
    replace: bool,
}

/// Failures that stop publication.
#[derive(Debug, Error)]
enum Error {
    /// An explicit base is needed when PR discovery cannot resolve one.
    #[error("could not resolve the PR base for {branch}; pass --base explicitly: {details}")]
    Base {
        /// Branch whose PR could not be resolved.
        branch: String,
        /// Discovery failure to report to the caller.
        details: String,
    },
    /// A subprocess rejected the requested operation.
    #[error("{command} failed: {details}")]
    Command {
        /// Program and arguments for the failed operation.
        command: String,
        /// Subprocess diagnostics or exit status.
        details: String,
    },
    /// The worktree cannot safely be rewritten.
    #[error("a clean worktree is required; commit or stash changes first")]
    DirtyWorktree,
    /// Git or GitHub returned text that cannot be interpreted safely.
    #[error("{program} returned invalid UTF-8: {source}")]
    Encoding {
        /// Program producing the invalid text.
        program: String,
        /// Original decoding failure.
        source: FromUtf8Error,
    },
    /// HEAD is detached or could not be read.
    #[error("cannot resolve the current branch; pass a branch explicitly: {0}")]
    Head(Box<Self>),
    /// A branch violates the supported grammar or operational byte limit.
    #[error("invalid branch name (expected 1..=1024 bytes and Git branch grammar)")]
    InvalidBranch,
    /// Git returned something other than a full object ID.
    #[error("invalid full commit ID")]
    InvalidCommit,
    /// Subprocess output did not contain exactly one protocol record.
    #[error("expected exactly one newline-terminated output record")]
    InvalidRecord,
    /// A subprocess could not be started or awaited.
    #[error("could not run {program}: {source}")]
    Io {
        /// Program that could not complete.
        program: String,
        /// Original operating system error.
        source: io::Error,
    },
    /// Linear rebase would flatten merge history.
    #[error(
        "the selected branch contains merge commits above the base; a linear branch is required"
    )]
    MergeHistory,
    /// An ancestry requirement failed, preserving the original failure.
    #[error("{branch} must include {ancestor} before proceeding; integrate it first: {source}")]
    NotAncestor {
        /// Required ancestor identity.
        ancestor: String,
        /// Source ref being checked.
        branch: String,
        /// Git's original diagnostic.
        source: Box<Self>,
    },
    /// Git defaults did not describe a supported single-branch publication.
    #[error(
        "unsupported push configuration: {0}; specify SOURCE:DESTINATION or adjust Git configuration"
    )]
    PushConfiguration(&'static str),
    /// Source and base cannot refer to the same branch.
    #[error("source and destination must differ from the base")]
    SameBranch,
}

/// Publication policies carry only the evidence needed by their push command.
enum Publication<'fetched> {
    /// Require remote ancestry and Git's reflog-based inclusion protection.
    Integrate,
    /// Authorize replacement only while the fetched destination tip is unchanged.
    Replace(&'fetched CommitId),
}

impl Publication<'_> {
    /// Rewritten history deliberately need not include the previous destination.
    const fn inclusion_option(&self) -> &str {
        match *self {
            Self::Integrate => "--force-if-includes",
            Self::Replace(_) => "--no-force-if-includes",
        }
    }

    /// Encode the lease at the Git boundary without consulting mutable refs again.
    fn lease(&self, destination: &str) -> String {
        match *self {
            Self::Integrate => "--force-with-lease".to_owned(),
            Self::Replace(expected) => format!(
                "--force-with-lease=refs/heads/{destination}:{}",
                expected.as_str()
            ),
        }
    }

    /// Replacement must not move sibling branches, even if enabled in Git config.
    const fn update_refs_option(&self) -> &str {
        match *self {
            Self::Integrate => "--update-refs",
            Self::Replace(_) => "--no-update-refs",
        }
    }
}

/// Read one optional configuration value without losing subprocess failures.
fn config(key: &str) -> Result<Option<String>, Error> {
    optional_query(&["config", "--get-all", key])?
        .map(|value| record(&value).map(str::to_owned))
        .transpose()
}

/// Git uses status one to signal a missing config key or detached symbolic HEAD.
fn optional_query(args: &[&str]) -> Result<Option<String>, Error> {
    let output = Command::new("git")
        .args(args)
        .output()
        .map_err(|source| Error::Io {
            program: "git".to_owned(),
            source,
        })?;
    let missing: i32 = 1;
    if output.status.code() == Some(missing) {
        return Ok(None);
    }
    if !output.status.success() {
        return Err(Error::Command {
            command: format!("git {}", args.join(" ")),
            details: format!(
                "{}; stderr: {:?}",
                output.status,
                String::from_utf8_lossy(&output.stderr)
            ),
        });
    }
    String::from_utf8(output.stdout)
        .map(Some)
        .map_err(|source| Error::Encoding {
            program: "git".to_owned(),
            source,
        })
}

/// Follow Git's push-remote precedence and sole-remote/origin fallback.
fn resolve_remote() -> Result<Remote, Error> {
    let head = optional_query(&["symbolic-ref", "--quiet", "HEAD"])?;
    let current = head
        .as_deref()
        .map(record)
        .transpose()?
        .map(|name| name.strip_prefix("refs/heads/").ok_or(Error::InvalidBranch))
        .transpose()?;
    if let Some(branch) = current
        && let Some(name) = config(&format!("branch.{branch}.pushRemote"))?
    {
        return Remote::try_new(&name);
    }
    if let Some(name) = config("remote.pushDefault")? {
        return Remote::try_new(&name);
    }
    if let Some(branch) = current
        && let Some(name) = config(&format!("branch.{branch}.remote"))?
    {
        return Remote::try_new(&name);
    }
    Remote::try_new(&fallback_remote()?)
}

/// Git uses the sole configured remote, otherwise origin.
fn fallback_remote() -> Result<String, Error> {
    let remotes = query("git", &["remote"])?;
    Ok(record(&remotes).unwrap_or("origin").to_owned())
}

/// Resolve only supported branch refspecs, preserving their exact spelling.
fn parse_selection(input: &str) -> Result<(BranchName, Option<BranchName>), Error> {
    let (source, destination_input) = input
        .split_once(':')
        .map_or((input, None), |(source, destination)| {
            (source, Some(destination))
        });
    if source.starts_with('+') {
        return Err(Error::InvalidBranch);
    }
    let source_name = if source == "HEAD" {
        current_branch().map_err(|error| Error::Head(Box::new(error)))?
    } else {
        source
            .strip_prefix("refs/heads/")
            .unwrap_or(source)
            .to_owned()
    };
    let branch = BranchName::try_new(&source_name)?;
    let destination = destination_input
        .map(|name| BranchName::try_new(name.strip_prefix("refs/heads/").unwrap_or(name)))
        .transpose()?;
    Ok((branch, destination))
}

/// Follow push.default only when the caller supplied no refspec.
fn default_destination(branch: &BranchName, remote: &Remote) -> Result<Option<BranchName>, Error> {
    let policy = config("push.default")?;
    match policy.as_deref().unwrap_or("simple") {
        "current" => Ok(None),
        "simple" | "upstream" | "tracking" => {
            let fetch_remote = match config(&format!("branch.{}.remote", branch.as_str()))? {
                Some(name) => name,
                None => fallback_remote()?,
            };
            let triangular = fetch_remote != remote.name();
            let simple = policy.as_deref().unwrap_or("simple") == "simple";
            if triangular && simple {
                return Ok(None);
            }
            if triangular {
                return Err(Error::PushConfiguration(
                    "upstream mode requires the upstream remote",
                ));
            }
            let upstream = config(&format!("branch.{}.merge", branch.as_str()))?;
            let Some(name) = upstream else {
                let automatic = query(
                    "git",
                    &[
                        "config",
                        "--type=bool",
                        "--default=false",
                        "--get",
                        "push.autoSetupRemote",
                    ],
                )?;
                return if record(&automatic)? == "true" {
                    Ok(None)
                } else {
                    Err(Error::PushConfiguration(
                        "the selected branch has no upstream",
                    ))
                };
            };
            let destination = BranchName::try_new(
                name.strip_prefix("refs/heads/")
                    .ok_or(Error::InvalidBranch)?,
            )?;
            if simple && destination != *branch {
                return Err(Error::PushConfiguration(
                    "simple mode requires matching upstream and local names",
                ));
            }
            Ok(Some(destination))
        }
        "matching" => Err(Error::PushConfiguration(
            "matching mode can publish multiple branches",
        )),
        "nothing" => Err(Error::PushConfiguration(
            "push.default=nothing requires an explicit refspec",
        )),
        _ => Err(Error::PushConfiguration("unrecognized push.default")),
    }
}

/// Apply a single configured push mapping or Git's default branch policy.
fn resolve_selection(args: &Args) -> Result<(RebaseTarget, Remote), Error> {
    let input = match args.branch.as_ref() {
        Some(branch) => branch.clone(),
        None => current_branch().map_err(|error| Error::Head(Box::new(error)))?,
    };
    let (branch, explicit_destination) = parse_selection(&input)?;
    query(
        "git",
        &[
            "show-ref",
            "--verify",
            &format!("refs/heads/{}", branch.as_str()),
        ],
    )?;
    let remote = resolve_remote()?;
    let mapping = config(&format!("remote.{}.push", remote.name()))?;
    let (source, destination) = if explicit_destination.is_some() {
        (branch, explicit_destination)
    } else if let Some(spec) = mapping {
        let (configured_source, configured_destination) = parse_selection(&spec)?;
        if args.branch.is_none() || configured_source == branch {
            (configured_source, configured_destination)
        } else {
            (branch, None)
        }
    } else if args.branch.is_none() {
        let destination = default_destination(&branch, &remote)?;
        (branch, destination)
    } else {
        (branch, None)
    };
    query(
        "git",
        &[
            "show-ref",
            "--verify",
            &format!("refs/heads/{}", source.as_str()),
        ],
    )?;
    let base = resolve_base(args, destination.as_ref().unwrap_or(&source), &remote)?;
    Ok((RebaseTarget::new(source, destination, base)?, remote))
}

/// Capture subprocess output, preserving command failures and exact text decoding.
fn query(program: &str, args: &[&str]) -> Result<String, Error> {
    let output = Command::new(program)
        .args(args)
        .output()
        .map_err(|source| Error::Io {
            program: program.to_owned(),
            source,
        })?;
    if !output.status.success() {
        return Err(Error::Command {
            command: format!("{program} {}", args.join(" ")),
            details: format!(
                "{}; stderr: {:?}",
                output.status,
                String::from_utf8_lossy(&output.stderr).trim()
            ),
        });
    }
    String::from_utf8(output.stdout).map_err(|source| Error::Encoding {
        program: program.to_owned(),
        source,
    })
}

/// Run a Git operation with its progress and diagnostics visible to the user.
fn git(args: &[&str]) -> Result<(), Error> {
    let status = Command::new("git")
        .args(args)
        .status()
        .map_err(|source| Error::Io {
            program: "git".to_owned(),
            source,
        })?;
    if !status.success() {
        return Err(Error::Command {
            command: format!("git {}", args.join(" ")),
            details: status.to_string(),
        });
    }
    Ok(())
}

/// Parse exactly one newline-terminated protocol record without changing identity.
fn record(text: &str) -> Result<&str, Error> {
    let value = text.strip_suffix('\n').ok_or(Error::InvalidRecord)?;
    if value.contains('\n') || value.contains('\r') {
        return Err(Error::InvalidRecord);
    }
    Ok(value)
}

/// Resolve only the selected branch's PR; never guess a default base.
fn resolve_base(args: &Args, source: &BranchName, remote: &Remote) -> Result<BranchName, Error> {
    let branch = source.as_str();
    if let Some(base) = args.base.as_ref() {
        return BranchName::try_new(base);
    }
    let output = query(
        "gh",
        &[
            "pr",
            "list",
            "--repo",
            remote.url(),
            "--head",
            branch,
            "--state",
            "open",
            "--limit",
            "2",
            "--json",
            "baseRefName",
            "--jq",
            ".[].baseRefName",
        ],
    )
    .map_err(|error| Error::Base {
        branch: branch.to_owned(),
        details: error.to_string(),
    })?;
    let base = record(&output).map_err(|error| Error::Base {
        branch: branch.to_owned(),
        details: format!("expected exactly one open PR: {error}"),
    })?;
    if base.is_empty() {
        return Err(Error::Base {
            branch: branch.to_owned(),
            details: "PR has no base branch".to_owned(),
        });
    }
    BranchName::try_new(base)
}

/// Confirm a published tip is included before rewriting it.
fn require_ancestor(ancestor: &str, branch: &str) -> Result<(), Error> {
    query("git", &["merge-base", "--is-ancestor", ancestor, branch]).map_err(|error| {
        Error::NotAncestor {
            ancestor: ancestor.to_owned(),
            branch: branch.to_owned(),
            source: Box::new(error),
        }
    })?;
    Ok(())
}

/// Show the mutation boundary without depending on cached remote refs.
#[expect(
    clippy::print_stdout,
    reason = "Dry-run output is the requested CLI result"
)]
fn print_plan(target: &RebaseTarget, remote: &Remote, replace: bool) {
    let remote_name = remote.name();
    let branch = target.branch().as_str();
    let base = target.base().as_str();
    let destination = target.destination().as_str();
    println!("Fetch {remote_name}/{base} and {remote_name}/{destination}");
    println!(
        "Source: {branch}; destination: {remote_name}/{destination}; base: {remote_name}/{base}"
    );
    println!("Require a clean worktree");
    if replace {
        println!(
            "Mode: replacement; PR lookup uses destination {destination} when --base is absent"
        );
        println!(
            "Pin the destination SHA during fetch (unknown until execution; dry-run does not fetch)"
        );
        println!("Skip destination ancestry check; do not use --force-if-includes");
        println!("Rebase {branch} onto the pinned base with --no-update-refs");
        println!(
            "Push only {branch}:{destination} with --force-with-lease=refs/heads/{destination}:<fetched-destination-sha>"
        );
    } else {
        println!("Require inclusion of {remote_name}/{destination}");
        println!("Rebase {branch} onto the fetched {remote_name}/{base} with --update-refs");
        println!(
            "Push only {branch}:{destination} to {remote_name} with --force-with-lease --force-if-includes"
        );
    }
}

/// Extract exactly one fetched object ID from Git's immutable porcelain output.
/// Reading tracking refs instead would admit a concurrent background fetch.
fn fetched_commit(output: &str, reference: &str) -> Result<CommitId, Error> {
    let mut matches = output.lines().filter_map(|line| {
        let fields = line.get(2..)?;
        let (_, remaining) = fields.split_once(' ')?;
        let (commit, name) = remaining.split_once(' ')?;
        (name == reference).then_some(commit)
    });
    let commit = matches.next().ok_or(Error::InvalidRecord)?;
    if matches.next().is_some() {
        return Err(Error::InvalidRecord);
    }
    CommitId::try_new(commit)
}

/// Fetch once, pin the fetched base, then rewrite and publish only on success.
fn publish(target: &RebaseTarget, remote: &Remote, replace: bool) -> Result<(), Error> {
    let remote_name = remote.name();
    let branch = target.branch().as_str();
    let base = target.base().as_str();
    let destination = target.destination().as_str();
    if !query("git", &["status", "--porcelain", "--untracked-files=all"])?.is_empty() {
        return Err(Error::DirtyWorktree);
    }
    let local_ref = format!("refs/heads/{branch}");
    let base_ref = format!("refs/remotes/{remote_name}/{base}");
    let remote_ref = format!("refs/remotes/{remote_name}/{destination}");
    let fetched = query(
        "git",
        &[
            "fetch",
            "--porcelain",
            "--verbose",
            "--refmap=",
            "--no-prune",
            "--no-prune-tags",
            "--no-recurse-submodules",
            "--atomic",
            "--no-tags",
            remote_name,
            &format!("+refs/heads/{base}:{base_ref}"),
            &format!("+refs/heads/{destination}:{remote_ref}"),
        ],
    )?;
    let base_commit = fetched_commit(&fetched, &base_ref)?;
    let base_sha = base_commit.as_str();
    let destination_commit = fetched_commit(&fetched, &remote_ref)?;
    let publication = if replace {
        Publication::Replace(&destination_commit)
    } else {
        require_ancestor(destination_commit.as_str(), &local_ref)?;
        Publication::Integrate
    };
    let merges = query(
        "git",
        &["rev-list", "--merges", &format!("{base_sha}..{local_ref}")],
    )?;
    if !merges.is_empty() {
        return Err(Error::MergeHistory);
    }
    git(&[
        "rebase",
        publication.update_refs_option(),
        "--no-autostash",
        "--no-autosquash",
        "--no-rebase-merges",
        "--no-fork-point",
        base_sha,
        branch,
    ])?;
    require_ancestor(base_sha, &local_ref)?;
    git(&[
        "push",
        &publication.lease(destination),
        publication.inclusion_option(),
        "--no-follow-tags",
        remote_name,
        &format!("{local_ref}:refs/heads/{destination}"),
    ])
}

/// Resolve HEAD by its full namespace, never Git's ambiguous short spelling.
fn current_branch() -> Result<String, Error> {
    let output = query("git", &["symbolic-ref", "--quiet", "HEAD"])?;
    let name = record(&output)?
        .strip_prefix("refs/heads/")
        .ok_or(Error::InvalidBranch)?;
    Ok(name.to_owned())
}

/// Resolve inputs before crossing the mutation boundary.
fn run(args: &Args) -> Result<(), Error> {
    query("git", &["rev-parse", "--show-toplevel"])?;
    let (target, remote) = resolve_selection(args)?;
    if args.dry_run {
        print_plan(&target, &remote, args.replace);
        return Ok(());
    }
    publish(&target, &remote, args.replace)
}

/// Report one actionable failure and preserve a nonzero process status.
#[expect(
    clippy::print_stderr,
    reason = "CLI failures must be visible to the caller"
)]
fn main() -> ExitCode {
    // A leading separator forwards --help past Git's manual-page interception.
    let mut arguments = env::args_os().skip(1).peekable();
    drop(arguments.next_if(|argument| argument == "--"));
    let args = Args::parse_from(once("git-push-up".into()).chain(arguments));
    match run(&args) {
        Ok(()) => ExitCode::SUCCESS,
        Err(error) => {
            eprintln!("error: {error}");
            ExitCode::FAILURE
        }
    }
}
